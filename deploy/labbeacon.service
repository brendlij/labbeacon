[Unit]
Description=Homelab metrics over MQTT
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=labbeacon
Group=labbeacon
EnvironmentFile=-/etc/labbeacon/environment
ExecStart=/usr/local/bin/labbeacon -config /etc/labbeacon/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/labbeacon
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
